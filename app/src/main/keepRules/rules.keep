# Reglas de R8 para RadiosLocales

# Preservar el modelo de datos para parseo JSON
-keep class com.deivela.radioslocales.Radio { *; }
-keep class com.deivela.radioslocales.RadioStore { *; }
-keep class com.deivela.radioslocales.PlaybackService { *; }
-keep class com.deivela.radioslocales.MainActivity { *; }

# Media3 ExoPlayer: DefaultMediaSourceFactory utiliza reflexión para instanciar HlsMediaSource$Factory.
# Sin estas reglas, R8 elimina la extensión de HLS en compilaciones Release.
-keep class androidx.media3.exoplayer.hls.** { *; }
-keep interface androidx.media3.exoplayer.hls.** { *; }
-keep class androidx.media3.exoplayer.source.** { *; }
-keep class androidx.media3.session.** { *; }
-keep class androidx.media3.datasource.** { *; }
-keep class androidx.media3.common.** { *; }

# Coil 3: Carga de imágenes en red
-keep class coil3.** { *; }
-keep interface coil3.** { *; }
